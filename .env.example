APP_ENV=production
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# GitHub Actions 发布到 GHCR 的真实镜像地址
# 格式：ghcr.io/<GitHub用户名或组织名>/<仓库名>:latest
TGQQ_IMAGE=ghcr.io/你的GitHub用户名/你的仓库名:latest

DATA_DIR=/app/data
LOG_DIR=/app/data/logs
MEDIA_DIR=/app/data/media
DATABASE_URL=sqlite+aiosqlite:////app/data/app.db

# Telegram 用户账号 API 凭据，请从 https://my.telegram.org/apps 获取
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=请替换为你的_api_hash
# 单账号兼容写法：未设置 TELEGRAM_ACCOUNTS_JSON 时，会自动映射为 id=default
TELEGRAM_PHONE=+8613800000000
TELEGRAM_SESSION_PATH=/app/data/sessions/user.session
# 多账号 session 根目录；省略 session_path 时使用 <dir>/<id>/account.session
TELEGRAM_SESSIONS_DIR=/app/data/sessions
# 多账号写法（推荐）：JSON 数组。每个账号独立 phone；session 默认落在 sessions/<id>/account.session
# TELEGRAM_ACCOUNTS_JSON=[{"id":"main","phone":"+8613800000000"},{"id":"news","phone":"+8613900000000"}]
# 也可显式指定 session_path（文件或账号目录均可）
# TELEGRAM_ACCOUNTS_JSON=[{"id":"main","session_path":"/app/data/sessions/main/account.session","phone":"+8613800000000"}]
# 任一账号未授权时是否 fail-fast；false 时允许部分账号启动
TELEGRAM_REQUIRE_ALL_ACCOUNTS=true
# 账号断线后自动重连
TELEGRAM_RECONNECT_ENABLED=true
TELEGRAM_RECONNECT_DELAY_SECONDS=5.0
# 两账号同时监听同一会话时，按 (chat_id,message_id) 去重，只处理第一次
TELEGRAM_DEDUPE_CROSS_ACCOUNT=false
TELEGRAM_DOWNLOAD_MEDIA=true
# 默认不转发 Telegram 自动生成的链接预览图片；真实附带媒体仍由 TELEGRAM_DOWNLOAD_MEDIA 控制
TELEGRAM_FORWARD_LINK_PREVIEW_MEDIA=false
TELEGRAM_MAX_MEDIA_MB=20
# Telegram 相册/多图消息聚合等待时间，避免同一组图文被拆成多次转发
TELEGRAM_ALBUM_BUFFER_SECONDS=2.0
# media 目录清理：每小时检查一次，删除 24 小时前的下载文件；设置为 0 可禁用
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
MEDIA_RETENTION_SECONDS=86400

# Telegram 管理 Bot，由 BotFather 创建
TG_ADMIN_BOT_TOKEN=123456:请替换为你的管理BotToken
ADMIN_TELEGRAM_USER_IDS=11111111,22222222
# 管理 Bot 网络较差时可调大这些超时，单位：秒
TG_ADMIN_BOT_CONNECT_TIMEOUT=15
TG_ADMIN_BOT_REQUEST_TIMEOUT=30
TG_ADMIN_BOT_POOL_TIMEOUT=15
TG_ADMIN_BOT_POLL_TIMEOUT=30
TG_ADMIN_BOT_POLL_READ_TIMEOUT=45
# 可选：Bot API（api.telegram.org）专用代理。大陆 VPS 上 api.telegram.org 常被阻断，
# 而 Telethon 的 MTProto 仍可用，此时会出现 admin bot / RSS 发布 ConnectError。
# 留空则沿用容器环境变量 HTTP_PROXY / HTTPS_PROXY；Telethon 不受此项影响。
# 容器访问宿主机代理示例：先在 compose 里加 extra_hosts: ["host.docker.internal:host-gateway"]
# TELEGRAM_BOT_PROXY=http://host.docker.internal:7890
# TELEGRAM_BOT_PROXY=socks5://host.docker.internal:1080

# 转发到 Telegram（QQ / 微信 → TG）
# 目标用「用户账号发送」时无需额外配置，复用上面已登录的 Telethon 账号；
# 想用 Bot API 发送时填这里，留空会依次回退 RSS_BOT_TOKEN、TG_ADMIN_BOT_TOKEN。
TELEGRAM_SEND_BOT_TOKEN=
# 单条 Telegram 发送超时（秒）
TELEGRAM_SEND_TIMEOUT_SECONDS=60

# Telegram Mini App 管理台。生产环境必须通过公网 HTTPS 域名访问。
MINI_APP_ENABLED=true
MINI_APP_HOST=0.0.0.0
MINI_APP_PORT=8000
MINI_APP_PUBLIC_URL=https://你的域名.example.com
MINI_APP_AUTH_TTL_SECONDS=3600
MINI_APP_ALLOWED_ORIGINS=https://你的域名.example.com

# RSS / RSSHub 订阅：在 Web 面板的「订阅」入口管理，默认复用管理 Bot 发布。
RSS_ENABLED=true
# 可选独立发布 Bot，只调用发送接口；不另开 getUpdates。
# RSS_BOT_TOKEN=123456:请替换为发布BotToken
RSS_POLL_SECONDS=10
RSS_REQUEST_TIMEOUT_SECONDS=20
RSS_MAX_FEED_BYTES=2097152
RSS_MAX_ENTRIES_PER_FEED=500
RSS_SEND_INTERVAL_SECONDS=1.1
RSS_MAX_SEND_ATTEMPTS=5
# 非公网地址默认拒绝；自建 RSSHub 使用明确主机白名单，不支持通配符。
# 例如同一 Compose 网络内 URL 为 http://rsshub:1200/... 时设置：
# RSS_ALLOWED_PRIVATE_HOSTS=rsshub
RSS_ALLOWED_PRIVATE_HOSTS=

# RSS 条目自动翻译：调用 OpenAI 兼容的 /v1/chat/completions 接口，源语言自动检测，
# 非中文才翻译，译文显示在原文下方。可对接 OpenAI、DeepSeek、通义千问、自建网关等。
# 接口地址可填完整端点（.../v1/chat/completions）或基础地址（.../v1，自动补全路径）。
# API Key 与接口地址均视为凭据，不要外泄或写入日志；本地无鉴权端点可留空。
# 翻译失败会自动回退原文，不影响抓取与发布；可用 RSS_TRANSLATE_ENABLED=false 整体关闭。
# 中文源由本地判定直接跳过，不消耗翻译额度。容器 HTTP(S)_PROXY 对该请求生效。
RSS_TRANSLATE_ENABLED=true
RSS_TRANSLATE_TARGET=ZH
RSS_TRANSLATE_API_URL=https://api.openai.com/v1/chat/completions
RSS_TRANSLATE_API_KEY=
RSS_TRANSLATE_MODEL=gpt-4o-mini
RSS_TRANSLATE_TIMEOUT_SECONDS=30
# 单个字段（标题或摘要）的翻译上限字符数，超长会截断后再翻译。
RSS_TRANSLATE_MAX_CHARS=1200
# 翻译请求的全局并发上限（预览、发送、试发共用；1=串行，最不容易触发上游限流）。
RSS_TRANSLATE_MAX_CONCURRENCY=1
# 瞬时错误（429 限流 / 超时 / 5xx）的总尝试次数，含首次请求；4xx 与格式错误不重试。
RSS_TRANSLATE_MAX_ATTEMPTS=3
# 重试退避基数（秒），按指数增长；上游返回 Retry-After 时优先遵循。
RSS_TRANSLATE_RETRY_BACKOFF_SECONDS=1

# QQ 官方机器人 WebSocket 凭据
QQ_BOT_APPID=请替换为你的QQ机器人AppID
QQ_BOT_SECRET=请替换为你的QQ机器人Secret
QQ_ENABLE_GROUP_C2C=true
QQ_ENABLE_GUILD_DIRECT_MESSAGE=false
QQ_ALLOW_SEND_WITHOUT_CACHED_MSG_ID=true
# 优先使用 QQ 原生 markdown；如果 QQ 官方接口拒绝，会自动降级成纯文本
QQ_USE_MARKDOWN=true
# 单条 QQ 发送（含多图顺序发送与重试）总超时；超时后记失败并继续消费队列
QQ_SEND_TIMEOUT_SECONDS=120
# QQ 入站附件（图片/视频/文件）下载。QQ CDN 链接有时效，收到消息就下载；
# 关闭后转发只带 `[图片] https://...` 文本说明
QQ_DOWNLOAD_MEDIA=true
QQ_MAX_MEDIA_MB=20
QQ_MEDIA_TIMEOUT_SECONDS=30

FORWARD_QUEUE_SIZE=1000

# ============ 个人微信（腾讯 iLink / openclaw-weixin 通道，可选） ============
# 扫码登录 + 长轮询，不需要 Webhook、AppID 或 Secret。
# 开启后既能接收微信好友私聊消息并转发到 QQ，也能把 Telegram 消息转发到微信好友。
WEIXIN_ENABLED=false
# 账号 id，决定凭证目录 data/weixin/<id>/credentials.json（0600）
WEIXIN_ACCOUNT_ID=default
WEIXIN_STATE_DIR=/app/data/weixin
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
# 扫码 bot 类型，与 openclaw-weixin 默认值一致，一般无需修改
WEIXIN_BOT_TYPE=3
# 长轮询与接口超时（秒）
WEIXIN_LONG_POLL_TIMEOUT_SECONDS=35
WEIXIN_API_TIMEOUT_SECONDS=60
# 二维码轮询间隔与最多自动刷新次数
WEIXIN_QR_POLL_INTERVAL_SECONDS=1.5
WEIXIN_QR_MAX_REFRESH=3
# 单条微信发送超时（秒）与单条文本长度上限（超长自动分段）
WEIXIN_SEND_TIMEOUT_SECONDS=60
WEIXIN_MAX_TEXT_CHARS=1500
# 微信媒体收发开关与单文件大小上限
WEIXIN_DOWNLOAD_MEDIA=true
WEIXIN_SEND_MEDIA=true
WEIXIN_MAX_MEDIA_MB=20

# 首次扫码登录：docker compose run --rm tgqq-forwarder python -m app.weixin.login
# 也可以直接在 Mini App 管理台「系统 → 个人微信」里扫码。
#
# 只做微信 ↔ QQ、不监听 Telegram 时可以关掉 Telegram 通道；
# 只做 Telegram ↔ 微信、不用 QQ 时可以关掉 QQ 通道（默认都开启）。
TELEGRAM_ENABLED=true
QQ_ENABLED=true
