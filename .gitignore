# Runtime data
/data/*
!/data/.gitkeep
!/data/sessions/.gitkeep
!/data/logs/.gitkeep
!/data/media/.gitkeep

# Secrets
.env
*.session
*.session-journal

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/

# Build output
/build/
/dist/

# Local verification scratch (screenshots, probe server, probe pages)
/.verify_rss/

# WorkBuddy agent workspace data (project memory, not repo content)
/.workbuddy-ai/

# OS/editor
.DS_Store
.vscode/
.idea/
